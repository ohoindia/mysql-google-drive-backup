# ---------------------------
# AWS RDS MySQL
# ---------------------------
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=change-me
DB_NAME=your_database

# ---------------------------
# Google OAuth 2.0
# Personal Google Drive
# ---------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Drive folder ID only, not the complete URL.
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUv

# Brevo SMTP email notifications (no template required)
# Copy the SMTP login from Brevo > SMTP & API > SMTP, not your account email.
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
# Example only: choose a sender allowed in your Brevo account.
BREVO_EMAIL_FROM=backups@ohoindialife.com
BREVO_EMAIL_FROM_NAME=Database Backup
BREVO_EMAIL_TO=you@example.com
